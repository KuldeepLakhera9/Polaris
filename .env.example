# POLARIS Maritime Operations Console - Environment Configuration

# 1. AISstream.io API Key (Free tier at aisstream.io)
# Required for live global AIS vessel tracking stream
AISSTREAM_API_KEY=

# 2. Server Port
PORT=3001

# 3. Sentinel Hub Credentials (Optional - for live Sentinel-1 SAR tiles)
# Free 30-day trial / limited PU tier at sentinel-hub.com
SENTINEL_HUB_INSTANCE_ID=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# 4. Data Cache TTL in minutes
CACHE_TTL_MINUTES=30

# Note: US National Ice Center (NIC), NASA GIBS, and Open-Meteo Marine APIs
# are completely open and require no API keys.
